# Device Setup
ldc_set_vcc -bank 1 3.3
ldc_set_sysconfig {CONFIGIO_VOLTAGE_BANK1=3.3 CONFIGIO_VOLTAGE_BANK2=3.3 BOOT_SEL=SINGLE COMPRESS_CONFIG=ON MCCLK_FREQ=160.0}
ldc_set_vcc -bank 2 3.3
# Outputs
ldc_set_location -site {W11} [get_ports {seg_display_o[7]}]
ldc_set_location -site {W12} [get_ports {seg_display_o[6]}]
ldc_set_location -site {V11} [get_ports {seg_display_o[5]}]
ldc_set_location -site {W10} [get_ports {seg_display_o[4]}]
ldc_set_location -site {V13} [get_ports {seg_display_o[3]}]
ldc_set_location -site {V12} [get_ports {seg_display_o[2]}]
ldc_set_location -site {T10} [get_ports {seg_display_o[1]}]
ldc_set_location -site {V10} [get_ports {seg_display_o[0]}]
ldc_set_location -site {R10} [get_ports {seg_sel_o[2]}]
ldc_set_location -site {V9}  [get_ports {seg_sel_o[1]}]
ldc_set_location -site {W9}  [get_ports {seg_sel_o[0]}]

ldc_set_location -site {N7}  [get_ports {led_display_o[0]}]
ldc_set_location -site {L7}  [get_ports {led_display_o[1]}]
ldc_set_location -site {L8}  [get_ports {led_display_o[2]}]
ldc_set_location -site {P8}  [get_ports {led_display_o[3]}]
ldc_set_location -site {M8}  [get_ports {led_display_o[4]}]
ldc_set_location -site {M9}  [get_ports {led_display_o[5]}]
ldc_set_location -site {P10} [get_ports {led_display_o[6]}]
ldc_set_location -site {N10} [get_ports {led_display_o[7]}]

# Inputs
ldc_set_location -site {U3} [get_ports clk_i]
ldc_set_location -site {AP15} [get_ports rstn_i]
ldc_set_port -iobuf {IO_TYPE=LVCMOS18 PULLMODE=NONE} [get_ports rstn_i]
ldc_set_attribute {FORMAT=HEX CODE=DEADBEEF}

